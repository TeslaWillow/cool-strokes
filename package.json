{
  "name": "my-stroke-lib",
  "version": "1.0.0",
  "type": "module",
  "description": "Vanilla JS & TypeScript library for customizable highlights, gradient underlines, and hand-drawn strokes",
  "main": "./dist/my-stroke-lib.cjs",
  "module": "./dist/my-stroke-lib.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": {
      "import": "./dist/my-stroke-lib.js",
      "require": "./dist/my-stroke-lib.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "keywords": [
    "underline",
    "highlight",
    "stroke",
    "svg",
    "typescript",
    "vanilla-js"
  ],
  "files": [
    "dist"
  ],
  "author": "Teslawillow",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2"
  }
}